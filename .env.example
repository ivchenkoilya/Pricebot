BOT_TOKEN=
ADMIN_TELEGRAM_ID=
TEST_MODE=true
DATABASE_URL=
PORT=8080
SERVE_HTTP=true
DEFAULT_TIMEZONE=Europe/Moscow
CHECK_INTERVAL_FREE_HOURS=12
CHECK_INTERVAL_PRO_HOURS=2
FREE_WATCH_LIMIT=3
PRO_WATCH_LIMIT=50
PRO_STARS_PRICE=199
REQUEST_TIMEOUT=20
MAX_PROVIDER_FAILURES=5
PROVIDER_BATCH_SIZE=20
SCHEDULER_TICK_SECONDS=60
MIN_DROP_PERCENT=3
ALERT_COOLDOWN_HOURS=6
USER_RATE_LIMIT_PER_MINUTE=20
GLOBAL_FETCH_CONCURRENCY=8
PER_HOST_FETCH_CONCURRENCY=2
MIN_HOST_REQUEST_INTERVAL_SECONDS=1
MAX_RESPONSE_BYTES=2000000
DISABLED_PROVIDERS=

# Optional AI layer. Keep the real key only in Amvera secrets.
AI_ENABLED=true
OPENAI_API_KEY=
# Leave empty for official OpenAI. For SmartAPI/other OpenAI-compatible gateways paste the exact Base URL from that provider's setup page.
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT=15
OPENAI_MAX_OUTPUT_TOKENS=300

# Read public product pages for AI context. Direct HTTP is attempted first.
# Jina Reader is a browser-rendered fallback for dynamic public pages.
PAGE_READER_JINA_ENABLED=true
# Optional; basic Jina Reader can work without a key. Never commit a real key.
JINA_READER_API_KEY=
PAGE_READER_TIMEOUT=25
PAGE_READER_MIN_CHARS=120
PAGE_READER_MAX_CHARS=24000
