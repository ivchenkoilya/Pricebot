# Telegram
BOT_TOKEN=
ADMIN_TELEGRAM_ID=
TEST_MODE=true

# Telegram Mini App
# Production example: https://your-amvera-domain.example/app/
WEBAPP_URL=
WEBAPP_AUTH_MAX_AGE_SECONDS=86400
WEBAPP_DEV_AUTH=false
WEBAPP_CORS_ORIGINS=

# SmartAPI / any OpenAI-compatible API
AI_ENABLED=true
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
FAST_MODEL=
SMART_MODEL=
VISION_MODEL=
# Optional known multimodal fallback on the same compatible endpoint.
VISION_FALLBACK_MODEL=
VISION_TIMEOUT=30
OPENAI_TIMEOUT=60
OPENAI_MAX_OUTPUT_TOKENS=1400
FAST_TEXT_CHARS=12000
CHUNK_PARALLELISM=4
RETRIEVAL_CHUNK_LIMIT=5
RECENT_MATERIAL_HOURS=12
IMAGE_MAX_SIDE=1600
IMAGE_JPEG_QUALITY=82

# Fast document pipeline: local extraction/indexing + one initial AI request.
DOCUMENT_FAST_PATH_CHARS=30000
DOCUMENT_DIGEST_MAX_CHARS=28000
DOCUMENT_CHARS_PER_PAGE=2500
DOCUMENT_MAX_TEXT_CHARS=1500000
DOCUMENT_AI_TIMEOUT=45
DOCUMENT_ANALYSIS_MAX_TOKENS=900
DOCUMENT_OCR_CONCURRENCY=1
DOCUMENT_OCR_PAGE_TIMEOUT=45

# Database / Amvera
DATABASE_URL=
DATA_DIR=
PORT=8080
SERVE_HTTP=true
DEFAULT_TIMEZONE=Europe/Moscow

# Clarify FREE / PRO / PRO MAX — Telegram Stars
PRO_STARS_PRICE=250
MAX_STARS_PRICE=350
FREE_DAILY_AI_LIMIT=20
PRO_DAILY_AI_LIMIT=100
MAX_DAILY_AI_LIMIT=250
# Hidden fair-use safety for the low-price monthly subscriptions.
PRO_MONTHLY_AI_LIMIT=1500
MAX_MONTHLY_AI_LIMIT=4000
FREE_VOICE_DAILY_LIMIT=3
FREE_VOICE_MAX_SECONDS=600
PRO_VOICE_MAX_SECONDS=1800
MAX_VOICE_MAX_SECONDS=3600
FREE_DOCUMENT_MAX_PAGES=15
PRO_DOCUMENT_MAX_PAGES=100
MAX_DOCUMENT_MAX_PAGES=200
MAX_FILE_SIZE_MB=25

# Future configurable weighted-usage units. Daily UI is still request-based.
USAGE_UNITS_TEXT=1
USAGE_UNITS_VISION=2
USAGE_UNITS_DOCUMENT=3
USAGE_UNITS_LARGE_DOCUMENT=5

# Growth / referrals. Both users receive this only after the invited user
# completes the first successful AI analysis. CTA first appears after three
# successful AI operations, then every five, with cooldowns to avoid spam.
REFERRAL_BONUS_REQUESTS=20
REFERRAL_PROMPT_FIRST_SUCCESS=3
REFERRAL_PROMPT_EVERY_SUCCESSES=5
REFERRAL_PROMPT_COOLDOWN_DAYS=3
REFERRAL_PROMPT_AFTER_CLICK_DAYS=7

# One-time request packs. Bonus requests do not expire and are spent only after
# the normal plan allowance is exhausted.
REQUEST_PACK_50_STARS=50
REQUEST_PACK_150_STARS=100
REQUEST_PACK_500_STARS=250

# Public video links (YouTube / Shorts / TikTok) stay disabled until a stable
# proxy path is configured. Directly uploaded Telegram videos are separate.
MEDIA_DOWNLOAD_ENABLED=false
MEDIA_MAX_FILE_MB=100
MEDIA_FREE_MAX_FILE_MB=50
MEDIA_MAX_DURATION_MINUTES=60
MEDIA_FREE_MAX_DURATION_MINUTES=10
MEDIA_VIDEO_MAX_HEIGHT=720
MEDIA_TEMP_DIR=/data/tmp/media
MEDIA_ACTION_TIMEOUT_SECONDS=27
MEDIA_INSPECT_TIMEOUT_SECONDS=8
MEDIA_SUBTITLE_TIMEOUT_SECONDS=5
MEDIA_FAST_SUBTITLES=true
MEDIA_METADATA_CACHE_SECONDS=900
MEDIA_WHISPER_MODEL=tiny
# Optional rotating HTTP(S) proxy. Keep credentials in Amvera secrets.
MEDIA_PROXY_URL=

# Speech-to-text
# Minimal Yandex SpeechKit setup for the standard Russian Yandex Cloud region:
# add ONLY these three values in Amvera. Endpoint/model/timeouts/fallback already
# have safe defaults in app/config/settings.py.
STT_PROVIDER=local
YANDEX_SPEECHKIT_API_KEY=
YANDEX_SPEECHKIT_FOLDER_ID=

# Local Whisper fallback
WHISPER_MODEL=base
WHISPER_QUALITY_FLOOR=true
WHISPER_LONG_MODEL=tiny
WHISPER_LONG_MODEL_AFTER_SECONDS=240
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=2
WHISPER_NUM_WORKERS=2
WHISPER_PARALLEL_CHUNKS=2
WHISPER_PARALLEL_THRESHOLD_SECONDS=90
WHISPER_CHUNK_SECONDS=120
WHISPER_BEAM_SIZE=1
WHISPER_CONDITION_ON_PREVIOUS_TEXT=false
WHISPER_CACHE_DIR=
STT_REMOTE_MODEL=whisper-1
STT_REMOTE_TIMEOUT=120

# Concurrency / abuse protection
MAX_AI_CONCURRENCY=4
MAX_STT_CONCURRENCY=1
MAX_DOCUMENT_CONCURRENCY=2
MAX_ACTIVE_JOBS_PER_USER=2
REQUESTS_PER_MINUTE=30
MATERIAL_TTL_DAYS=30
MAX_MATERIAL_CHARS=1500000

# Legacy PRICE modules are kept in the repository for rollback/reference.
CHECK_INTERVAL_FREE_HOURS=12
CHECK_INTERVAL_PRO_HOURS=2
FREE_WATCH_LIMIT=3
PRO_WATCH_LIMIT=50
REQUEST_TIMEOUT=20
MAX_PROVIDER_FAILURES=5
PROVIDER_BATCH_SIZE=20
SCHEDULER_TICK_SECONDS=60
MIN_DROP_PERCENT=3
ALERT_COOLDOWN_HOURS=6
USER_RATE_LIMIT_PER_MINUTE=20
GLOBAL_FETCH_CONCURRENCY=8
PER_HOST_FETCH_CONCURRENCY=2
MIN_HOST_REQUEST_INTERVAL_SECONDS=1
MAX_RESPONSE_BYTES=2000000
DISABLED_PROVIDERS=
PAGE_READER_JINA_ENABLED=true
JINA_READER_API_KEY=
PAGE_READER_TIMEOUT=25
PAGE_READER_MIN_CHARS=120
PAGE_READER_MAX_CHARS=24000
