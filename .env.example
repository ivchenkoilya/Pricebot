# Telegram
BOT_TOKEN=
ADMIN_TELEGRAM_ID=
TEST_MODE=true

# Telegram Mini App
# Production example: https://your-amvera-domain.example/app/
WEBAPP_URL=
WEBAPP_AUTH_MAX_AGE_SECONDS=86400
# Keep false in production. Only enables X-Dev-Telegram-User for local testing.
WEBAPP_DEV_AUTH=false
# Usually blank because Mini App and API are same-origin. Comma-separated HTTPS origins only if needed.
WEBAPP_CORS_ORIGINS=

# SmartAPI / any OpenAI-compatible API
AI_ENABLED=true
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
FAST_MODEL=
SMART_MODEL=
VISION_MODEL=
OPENAI_TIMEOUT=60
OPENAI_MAX_OUTPUT_TOKENS=1400
FAST_TEXT_CHARS=12000
CHUNK_PARALLELISM=4
RETRIEVAL_CHUNK_LIMIT=5
RECENT_MATERIAL_HOURS=12
IMAGE_MAX_SIDE=1600
IMAGE_JPEG_QUALITY=82

# Database / Amvera
DATABASE_URL=
DATA_DIR=
PORT=8080
SERVE_HTTP=true
DEFAULT_TIMEZONE=Europe/Moscow

# FREE / PRO
PRO_STARS_PRICE=299
FREE_DAILY_AI_LIMIT=10
PRO_DAILY_AI_LIMIT=150
FREE_VOICE_DAILY_LIMIT=3
FREE_VOICE_MAX_SECONDS=120
FREE_DOCUMENT_MAX_PAGES=10
PRO_DOCUMENT_MAX_PAGES=200
MAX_FILE_SIZE_MB=25

# Speech-to-text
# local = faster-whisper on server CPU
# remote = OpenAI-compatible audio transcription endpoint (usually much faster)
STT_PROVIDER=local
WHISPER_MODEL=base
STT_REMOTE_MODEL=whisper-1
STT_REMOTE_TIMEOUT=25
WHISPER_COMPUTE_TYPE=int8
WHISPER_CACHE_DIR=

# Concurrency / abuse protection
MAX_AI_CONCURRENCY=4
MAX_STT_CONCURRENCY=1
MAX_DOCUMENT_CONCURRENCY=2
MAX_ACTIVE_JOBS_PER_USER=2
REQUESTS_PER_MINUTE=30
MATERIAL_TTL_DAYS=30
MAX_MATERIAL_CHARS=400000

# Legacy PRICE modules are kept in the repository for rollback/reference.
CHECK_INTERVAL_FREE_HOURS=12
CHECK_INTERVAL_PRO_HOURS=2
FREE_WATCH_LIMIT=3
PRO_WATCH_LIMIT=50
REQUEST_TIMEOUT=20
MAX_PROVIDER_FAILURES=5
PROVIDER_BATCH_SIZE=20
SCHEDULER_TICK_SECONDS=60
MIN_DROP_PERCENT=3
ALERT_COOLDOWN_HOURS=6
USER_RATE_LIMIT_PER_MINUTE=20
GLOBAL_FETCH_CONCURRENCY=8
PER_HOST_FETCH_CONCURRENCY=2
MIN_HOST_REQUEST_INTERVAL_SECONDS=1
MAX_RESPONSE_BYTES=2000000
DISABLED_PROVIDERS=
PAGE_READER_JINA_ENABLED=true
JINA_READER_API_KEY=
PAGE_READER_TIMEOUT=25
PAGE_READER_MIN_CHARS=120
PAGE_READER_MAX_CHARS=24000
